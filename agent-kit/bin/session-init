#!/usr/bin/env bash
# Prepare a sandbox for an agent session: what the launcher runs inside the
# sandbox, as the agent user, before the agent starts. Idempotent: safe to run
# again on a re-attached sandbox.
set -euo pipefail
: "${AGENT_KIT_DIR:?}"

# The agent user's part: git identity, checkouts, the agent's instructions.
"$AGENT_KIT_DIR/bin/session-setup"

# Harden on the first launch, while sudo still exists; nothing after this may
# need root. Then verify on every launch, as the agent itself, with the groups
# sbx gives it: the launch stops unless the agent can't become root.
if sudo -n true 2>/dev/null; then
    sudo --preserve-env=AGENT_KIT_DIR "$AGENT_KIT_DIR/bin/session-harden"
fi
"$AGENT_KIT_DIR/bin/session-harden" --verify
