#!/usr/bin/env bash
# Prepare a sandbox for an agent session. Run as the agent user before the
# agent starts. Idempotent: safe to run again on a re-attached sandbox.
#
# The sandbox has no host checkout: the project is cloned here from
# $AGENT_REPO_URL into $AGENT_PROJECT_DIR. Assumes the foundry has already
# created task/$AGENT_TASK and pushed a skeleton .agent/$AGENT_TASK/TASK.md on
# agent-notes. Anything missing is an error, not something to create here.
set -euo pipefail
: "${AGENT_TASK:?}" "${AGENT_ROLE:?}" "${AGENT_REPO_URL:?}" "${AGENT_PROJECT_DIR:?}" "${AGENT_NOTES_DIR:?}" "${AGENT_KIT_DIR:?}"

role_path="$AGENT_KIT_DIR/roles/$AGENT_ROLE"
[[ -f "$role_path/gitconfig" ]] || { echo "session-init: $role_path/gitconfig is missing" >&2; exit 1; }

# --- Git identity -------------------------------------------------------------
# Global, so both checkouts share it. Name, email, signing key and shared
# behaviour all come from the role's gitconfig and what it includes.

git config --global include.path "$role_path/gitconfig"
# Lets agents verify commits signed by any role, or by you.
git config --global gpg.ssh.allowedSignersFile "$AGENT_KIT_DIR/git/allowed_signers"

if [[ "$(git config --get commit.gpgsign || true)" == true ]] \
   && [[ -z "$(git config --get user.signingkey || true)" ]]; then
    echo "session-init: $AGENT_ROLE signs commits but $role_path/gitconfig sets no user.signingkey" >&2
    exit 1
fi

# --- Checkouts ----------------------------------------------------------------

if [[ ! -d "$AGENT_PROJECT_DIR/.git" ]]; then
    mkdir -p "$(dirname "$AGENT_PROJECT_DIR")"
    # Blobless partial clone: full history of commits, file contents fetched on
    # demand. Keeps large repositories fast without the limits of --depth.
    git clone --filter=blob:none "$AGENT_REPO_URL" "$AGENT_PROJECT_DIR"
fi
cd "$AGENT_PROJECT_DIR"

git config core.hooksPath "$AGENT_KIT_DIR/hooks"   # read-only mount: agents cannot alter hooks

git fetch origin

# The task must already exist on origin: created with its branch and a TASK.md
# on agent-notes before any agent runs. Say so plainly rather than let git fail.
missing=()
git show-ref -q --verify "refs/remotes/origin/task/$AGENT_TASK" || missing+=("branch task/$AGENT_TASK")
git show-ref -q --verify refs/remotes/origin/agent-notes || missing+=("branch agent-notes")
if ((${#missing[@]})); then
    echo "session-init: task $AGENT_TASK has not been created on $AGENT_REPO_URL: missing ${missing[*]}." >&2
    echo "  Create the task branch from main and push .agent/$AGENT_TASK/TASK.md on agent-notes, then run again." >&2
    exit 1
fi

if git show-ref -q --verify "refs/heads/task/$AGENT_TASK"; then
    git switch "task/$AGENT_TASK"
else
    git switch -c "task/$AGENT_TASK" --track "origin/task/$AGENT_TASK"
fi

if [[ ! -d "$AGENT_NOTES_DIR" ]]; then
    if git show-ref -q --verify refs/heads/agent-notes; then
        git worktree add "$AGENT_NOTES_DIR" agent-notes
    else
        git worktree add --track -b agent-notes "$AGENT_NOTES_DIR" origin/agent-notes
    fi
fi

task_md_path="$AGENT_NOTES_DIR/.agent/$AGENT_TASK/TASK.md"
[[ -f "$task_md_path" ]] || {
    echo "session-init: agent-notes has no .agent/$AGENT_TASK/TASK.md; push the task's TASK.md there, then run again." >&2
    exit 1
}

# --- Agent instructions -------------------------------------------------------
# Claude Code loads ~/.claude/CLAUDE.md in every session and follows its @
# imports without the approval dialog it shows for imports in a project file.
# Rewritten at every launch, so edits made inside the sandbox don't persist.

import_path() { printf '@%s\n' "${1// /\\ }"; }   # an @ import needs spaces escaped
mkdir -p "$HOME/.claude"
{
    echo "<!-- Written by session-init at every launch; edits here are discarded. -->"
    import_path "$AGENT_KIT_DIR/AGENTS.md"
    import_path "$role_path/ROLE.md"
    import_path "$task_md_path"
} > "$HOME/.claude/CLAUDE.md"

echo "session-init: checkouts ready"
git -C "$AGENT_PROJECT_DIR" status -sb | head -1
git -C "$AGENT_NOTES_DIR"   status -sb | head -1

# --- Harden, last -------------------------------------------------------------
# Installs Claude's managed settings and removes sudo, su and Docker. Nothing
# after this may need root. On a re-attached sandbox sudo is already gone and
# this is skipped.

if sudo -n true 2>/dev/null; then
    sudo --preserve-env=AGENT_KIT_DIR "$AGENT_KIT_DIR/bin/session-harden"
elif [[ -f /etc/claude-code/managed-settings.json ]]; then
    echo "session-init: already hardened"
else
    echo "session-init: no sudo and no managed settings installed; cannot harden this sandbox" >&2
    exit 1
fi
