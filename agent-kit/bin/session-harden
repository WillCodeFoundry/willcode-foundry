#!/usr/bin/env bash
# Root part of session setup. Installs Claude's managed settings, then
# removes the agent user's ability to become root again. Run once, last,
# via sudo from session-init. After it returns, nothing inside the sandbox
# can undo what it did.
set -euo pipefail
: "${AGENT_KIT_DIR:?}"
[[ $EUID -eq 0 ]] || { echo "lockdown: must run as root" >&2; exit 1; }

agent_user="${SUDO_USER:-agent}"

# 1. Managed settings: root-owned, world-readable, agent cannot write.
install -d -m 0755 -o root -g root /etc/claude-code
install    -m 0644 -o root -g root \
    "$AGENT_KIT_DIR/claude/managed-settings.json" \
    /etc/claude-code/managed-settings.json

# 2. Remove passwordless sudo for the agent user, every way it can be granted.
rm -f /etc/sudoers.d/*
sed -i -E '/NOPASSWD/d' /etc/sudoers 2>/dev/null || true
for g in sudo wheel admin; do
    getent group "$g" >/dev/null && gpasswd -d "$agent_user" "$g" >/dev/null 2>&1 || true
done
# Belt and braces: no setuid sudo at all.
chmod 0000 /usr/bin/sudo 2>/dev/null || true
command -v doas >/dev/null && chmod 0000 "$(command -v doas)" || true

# 3. Verify as the agent user.
if su -s /bin/sh "$agent_user" -c 'sudo -n true' 2>/dev/null; then
    echo "lockdown: FAILED, $agent_user can still sudo" >&2
    exit 1
fi
echo "lockdown: managed settings installed, sudo removed for $agent_user"
