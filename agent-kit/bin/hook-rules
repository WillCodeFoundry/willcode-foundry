#!/usr/bin/env bash
# Print every rule the git hooks enforce, without triggering any of them.
# Rules are the "RULE" comment lines at the top of each hooks/lib script.
set -euo pipefail
lib="$(dirname "$0")/../hooks/lib"

for f in "$lib"/check-*.sh; do
    echo "$(basename "$f" .sh):"
    sed -n 's/^#   RULE  /  - /p; s/^#         /    /p' "$f"
    echo
done
