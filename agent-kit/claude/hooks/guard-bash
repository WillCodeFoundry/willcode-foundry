#!/usr/bin/env python3
"""PreToolUse guard for Bash commands: don't skip or reconfigure the git hooks.

Refuses a command with a word that is --no-verify, or that mentions
core.hooksPath. Reads the tool call as JSON on stdin; exits 2 with a reason
on stderr to refuse. A quoted word stays one word, so a commit message that
mentions --no-verify passes.

A guardrail against the common slip of reaching for --no-verify when a hook
refuses, not a security boundary: the project's GitHub rulesets refuse what
matters once pushed. Accepted misses, on purpose, to keep this simple:
`git commit -n`, abbreviations such as --no-ver, --no-verify inside
`sh -c "..."`, and `git config --get core.hooksPath` being refused although
it only reads.
"""

import json
import shlex
import sys


def refusal_reason(command: str) -> str | None:
    try:
        words = shlex.split(command)
    except ValueError:  # unbalanced quotes: refuse rather than guess what runs
        return "the command could not be parsed; quote it so each argument is clear"
    if "--no-verify" in words:
        return "git hooks must not be bypassed (--no-verify)"
    if any("core.hookspath" in word.lower() for word in words):
        return "git hook configuration must not be changed"
    return None


def main() -> int:
    try:
        command = json.load(sys.stdin).get("tool_input", {}).get("command", "")
    except (json.JSONDecodeError, AttributeError):
        return 0  # not a tool call we understand; don't block
    reason = refusal_reason(command) if isinstance(command, str) else None
    if reason is None:
        return 0
    print(
        f"guard-bash: refusing\n\n  {reason}.\n  Command: {command}\n\n"
        "  Fix the cause instead. If you believe this is wrong, record it under\n"
        "  Blockers in PROGRESS.md and ask.",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    sys.exit(main())
