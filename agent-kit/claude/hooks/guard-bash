#!/usr/bin/env python3
"""PreToolUse guard for Bash commands.

Catches commands that would skip or undo the git rules, and says what to do
instead. Reads the tool call as JSON on stdin; exits 2 with a reason on
stderr to refuse.

  RULE  Git hooks are not bypassed or reconfigured.
  RULE  History is not rewritten and remote branches are not deleted.

This is a guardrail against mistakes, such as reaching for --no-verify when a
hook fails, not a security boundary: it reads command text, so a script, an
alias or another language gets past it. The protections that hold are the
sandbox, root-owned managed settings with sudo removed (session-harden), the
role's credentials, and the project's GitHub rules.

The command is split into simple commands on ;, &&, || and |, and each is
checked by its words, so text that merely mentions a flag (a commit message,
a file name) is not refused. Commands run through `sh -c` / `bash -c` are
checked too.
"""

import json
import re
import shlex
import sys
from collections.abc import Iterator

SHELLS = {"sh", "bash", "zsh", "dash"}
REWRITE = {"rebase", "filter-branch", "filter-repo"}
SEPARATORS = {";", "&&", "||", "|", "&", "(", ")"}
WRAPPERS = {"env", "command", "exec"}
ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=.*")
# Checked against the whole command: the name is dangerous wherever it appears,
# including inside environment variables such as GIT_CONFIG_PARAMETERS.
HOOKS_PATH = re.compile(r"core\.hookspath", re.IGNORECASE)


def simple_commands(command: str) -> Iterator[list[str]]:
    """Yield each simple command's words, descending into `sh -c '...'`."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|()")
    lexer.whitespace_split = True
    words: list[str] = []
    for token in lexer:
        if token in SEPARATORS or set(token) <= set(";&|"):
            if words:
                yield from _expand(words)
            words = []
        else:
            words.append(token)
    if words:
        yield from _expand(words)


def _expand(words: list[str]) -> Iterator[list[str]]:
    words = _strip_prefix(words)
    if len(words) >= 3 and words[0].rsplit("/", 1)[-1] in SHELLS and "-c" in words[1:-1]:
        yield from simple_commands(words[words.index("-c") + 1])
    elif words:
        yield words


def _strip_prefix(words: list[str]) -> list[str]:
    """Drop leading VAR=value assignments and `env`/`command`/`exec` wrappers."""
    i = 0
    while i < len(words) and (ASSIGNMENT.fullmatch(words[i]) or words[i] in WRAPPERS):
        i += 1
    return words[i:]


def git_subcommand(words: list[str]) -> tuple[str, list[str]] | None:
    """For a git command, its subcommand and the words after it; else None."""
    if not words or words[0].rsplit("/", 1)[-1] != "git":
        return None
    i = 1
    while i < len(words) and words[i].startswith("-"):
        i += 2 if words[i] in {"-c", "-C", "--git-dir", "--work-tree", "--namespace"} else 1
    return (words[i], words[i + 1 :]) if i < len(words) else None


def short_flags(args: list[str]) -> set[str]:
    """Letters in short-option clusters such as -nm or -uf; long options and values excluded."""
    return {ch for a in args if a.startswith("-") and not a.startswith("--") for ch in a[1:]}


def refusal_reason_for(words: list[str]) -> str | None:
    git = git_subcommand(words)
    if git is None:
        return None
    sub, args = git
    if "--no-verify" in args or (sub == "commit" and "n" in short_flags(args)):
        return "git hooks must not be bypassed (--no-verify / -n)"
    if sub == "push":
        if {"--force", "--mirror", "--prune"} & set(args) or any(a.startswith("--force") for a in args):
            return "force-push is not allowed"
        if "--delete" in args or "d" in short_flags(args) or any(a.startswith(":") for a in args):
            return "deleting remote branches is not allowed"
        if "f" in short_flags(args) or any(a.startswith("+") for a in args):
            return "force-push is not allowed"
    if sub in REWRITE or (sub == "reset" and "--hard" in args):
        return "rewriting history is not allowed; use git pull --rebase only"
    return None


def refusal_reason(command: str) -> str | None:
    """The reason to refuse ``command``, or None to let it run."""
    if HOOKS_PATH.search(command):
        return "git hook configuration must not be changed"
    try:
        commands = list(simple_commands(command))
    except ValueError:  # unbalanced quotes: refuse rather than guess what runs
        return "the command could not be parsed; quote it so each argument is clear"
    for words in commands:
        reason = refusal_reason_for(words)
        if reason:
            return reason
    return None


def main() -> int:
    try:
        call = json.load(sys.stdin)
        command = call.get("tool_input", {}).get("command", "")
    except (json.JSONDecodeError, AttributeError):
        return 0  # not a tool call we understand; don't block
    reason = refusal_reason(command) if isinstance(command, str) else None
    if reason is None:
        return 0
    print(
        f"guard-bash: refusing\n\n  {reason}.\n  Command: {command}\n\n"
        "  Fix the cause instead. If you believe this is wrong, record it under\n"
        "  Blockers in PROGRESS.md and ask.",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    sys.exit(main())
