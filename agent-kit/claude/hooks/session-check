#!/usr/bin/env bash
# Stop hook: refuse to end the session while either checkout has uncommitted
# or unpushed work. The reason is fed back to the agent as its next instruction.
#
#   RULE  A session cannot end with uncommitted or unpushed changes.
set -euo pipefail
: "${AGENT_TASK:?}" "${AGENT_PROJECT_DIR:?}" "${AGENT_NOTES_DIR:?}"
# For ShellCheck, relative to the repository root, where CI runs it:
# shellcheck source=agent-kit/lib/task.sh
source "$(dirname "$0")/../../lib/task.sh"

# Already looping on this hook: let the stop through rather than spin. Input
# that isn't the JSON Claude Code sends is not a reason to let it through.
if python3 -c 'import json, sys; sys.exit(0 if json.load(sys.stdin).get("stop_hook_active") is True else 1)' 2>/dev/null; then
    exit 0
fi

problems=()
report_unsaved_work() {  # report_unsaved_work <dir> <branch> <label>
    local dir="$1" branch="$2" label="$3"
    if [[ -n "$(git -C "$dir" status --porcelain)" ]]; then
        problems+=("$label has uncommitted changes")
    fi
    git -C "$dir" fetch -q origin "$branch" 2>/dev/null || true
    if [[ -n "$(git -C "$dir" log --oneline "origin/$branch..HEAD" 2>/dev/null)" ]]; then
        problems+=("$label has commits not pushed to origin/$branch")
    fi
}
report_unsaved_work "$AGENT_PROJECT_DIR" "$TASK_BRANCH"  "code checkout"
report_unsaved_work "$AGENT_NOTES_DIR"   "$NOTES_BRANCH" "notes checkout"

if ((${#problems[@]} == 0)); then
    exit 0
fi

problem_summary="$(printf '%s; ' "${problems[@]}")"
reason="Cannot end the session yet: ${problem_summary%; }. Commit and push that work (see \"Git rules\" in AGENTS.md), then finish."
python3 -c 'import json,sys; print(json.dumps({"decision":"block","reason":sys.argv[1]}))' "$reason"
