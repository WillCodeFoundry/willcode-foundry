#!/usr/bin/env bash
# Adds a "Task: <task>" trailer to every commit on the task branch, so each
# code commit traces back to its task without the agent having to remember.
# This runs even with --no-verify. git passes the message file as $1.
set -euo pipefail
# For ShellCheck, relative to the repository root, where CI runs it:
# shellcheck source=agent-kit/hooks/lib/common.sh
source "$(dirname "$0")/lib/common.sh"

[[ "$(current_branch)" == "$TASK_BRANCH" ]] || exit 0
message_file="${1:?prepare-commit-msg needs the message file}"

# An empty message aborts the commit; a trailer would make it go through.
[[ -n "$(git stripspace --strip-comments < "$message_file")" ]] || exit 0
git interpret-trailers --in-place --if-exists doNothing --trailer "Task: $AGENT_TASK" "$message_file"
