#!/usr/bin/env bash
# Pushes only to this task's branch and agent-notes. The project's GitHub
# rulesets allow any task/**, since GitHub can't tell one task from another;
# this keeps a role to its own. git passes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail
# For ShellCheck, relative to the repository root, where CI runs it:
# shellcheck source=agent-kit/hooks/lib/common.sh
source "$(dirname "$0")/lib/common.sh"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        "refs/heads/$TASK_BRANCH"|"refs/heads/$NOTES_BRANCH") ;;
        *) refuse pre-push "You may only push $TASK_BRANCH and $NOTES_BRANCH, not ${remote_ref#refs/heads/}." \
               "Code goes on $TASK_BRANCH; notes go on $NOTES_BRANCH." ;;
    esac
done
