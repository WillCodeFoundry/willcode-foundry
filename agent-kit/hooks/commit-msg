#!/usr/bin/env bash
# Commits on the task branch end with a "Task: <task>" trailer, so every code
# commit traces back to its task. git passes the message file as $1.
# (Attribution trailers are kept out by Claude's managed settings, not here.)
set -euo pipefail
source "$(dirname "$0")/lib/common.sh"

[[ "$(current_branch)" == "$TASK_BRANCH" ]] || exit 0

message_file="${1:?commit-msg hook needs the message file}"
# Ignore the comment lines git adds when the message is written in an editor.
trailers=$(git stripspace --strip-comments < "$message_file" | git interpret-trailers --parse)

if ! grep -qx "Task: $AGENT_TASK" <<<"$trailers"; then
    refuse commit-msg \
        "Commits on $TASK_BRANCH must end with the trailer:" \
        "    Task: $AGENT_TASK" \
        "" \
        "Add it as the last paragraph of the message, for example:" \
        "    git commit -m \"feat(scope): summary\" -m \"Why.\" -m \"Task: $AGENT_TASK\""
fi
