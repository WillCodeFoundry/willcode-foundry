# --- Foundry instance ---------------------------------------------------------

# Credentials handed to sandboxes: SSH keys, API keys, env files.
# Everything is ignored except the .gitkeep files that preserve the folder layout.
secrets/*
!secrets/ssh/
secrets/ssh/*
!secrets/ssh/.gitkeep
!secrets/env/
secrets/env/*
!secrets/env/.gitkeep

# Per-session records written by the foundry
sessions/

# Local overrides of instance config
config/*.local.yaml

# Docker Sandboxes metadata
.sbx/

# --- Python -------------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging and build
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
MANIFEST

# Virtual environments (anchored to the root so secrets/env/ is not caught)
/.venv/
/venv/
/env/
/ENV/

# uv and pip
# Keep uv.lock committed for an application; remove the next line if this becomes a library
# uv.lock
.python-version.local
pip-log.txt
pip-delete-this-directory.txt

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Type checking and linting
.mypy_cache/
.pyright/
.ruff_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# --- Environment and editors --------------------------------------------------

.env
.env.*
!.env.example

.vscode/
.idea/
*.swp
*.swo
*~

.DS_Store
Thumbs.db

# --- Misc ---------------------------------------------------------------------

*.log
*.tmp